<?xml version="1.0" encoding="UTF-8"?>
<!-- Read-only mapping of <prefix>seed_run (the prefix and the binary collations are added by SchemaMetadataListener). -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\SeedKitBundle\Infrastructure\Doctrine\Entity\SeedRun" table="seed_run" read-only="true">
        <indexes>
            <index name="seed_run_scope_idx" columns="scope_kind,scope_id,created_at"/>
            <index name="seed_run_status_idx" columns="status,expires_at"/>
            <index name="seed_run_actor_idx" columns="actor_ref"/>
        </indexes>
        <id name="id" type="string" column="id" length="36"/>
        <field name="scopeKind" type="string" column="scope_kind" length="32"/>
        <field name="scopeId" type="string" column="scope_id" length="128">
            <options>
                <option name="default"></option>
            </options>
        </field>
        <field name="actorRef" type="string" column="actor_ref" length="190" nullable="true"/>
        <field name="channel" type="string" column="channel" length="16"/>
        <field name="status" type="string" column="status" length="24"/>
        <field name="providers" type="json" column="providers"/>
        <field name="prune" type="boolean" column="prune"/>
        <field name="documentHash" type="string" column="document_hash" length="71" nullable="true"/>
        <field name="planHash" type="string" column="plan_hash" length="68"/>
        <field name="batchDigests" type="json" column="batch_digests"/>
        <field name="batchesDone" type="integer" column="batches_done"/>
        <field name="counts" type="json" column="counts"/>
        <field name="document" type="blob" column="document" nullable="true"/>
        <field name="errorCode" type="string" column="error_code" length="16" nullable="true"/>
        <field name="version" type="integer" column="version"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at" nullable="true"/>
        <field name="finishedAt" type="datetime_immutable" column="finished_at" nullable="true"/>
    </entity>
</doctrine-mapping>
